RD_THEME_CHECK_BOX='.rd_check-box{display:inline-flex;outline:1px solid transparent;outline-offset:2px}.rd_check-box:before{content:"";display:block;pointer-events:none;width:0;height:0;font-size:0;position:absolute;background:var(--box-main-color);border-radius:50%;transition:all .2s;background-image:url('data:image/svg+xml;utf8,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke-width="4" stroke="%23fff"><path d="M5 12.5l4.5 4.5L19 7.5" /></svg>');background-size:1em;background-position:50%;background-repeat:no-repeat;opacity:0}.rd_check-box_indeterminate:before{width:8px;height:8px;border-radius:2px;opacity:1}.rd_check-box:has(.rd_check-box_input:checked):before{width:var(--box-size);height:var(--box-size);border-radius:inherit;font-size:var(--box-font-size);opacity:1}.rd_check-box:has(.rd_check-box_input:focus-visible){outline-color:var(--box-main-color)}.rd_check-box_input{position:absolute;opacity:0;cursor:inherit}'
