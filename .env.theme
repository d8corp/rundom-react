RD_THEME_TYPOGRAPHY='.rd_typography>:first-child{margin-top:0}.rd_typography>:last-child{margin-bottom:0}.rd_typography h1,.rd_typography h2,.rd_typography h3,.rd_typography h4,.rd_typography h5,.rd_typography h6{color:light-dark(#7c3aed,#8b5cf6);transition:color .2s}.rd_typography h1:has(+hr),.rd_typography h2:has(+hr),.rd_typography h3:has(+hr),.rd_typography h4:has(+hr),.rd_typography h5:has(+hr),.rd_typography h6:has(+hr){margin-bottom:0}.rd_typography h1{font-size:calc(clamp(40px,8vw,72px));margin:24px 0;font-weight:800;line-height:1.2;letter-spacing:-.03em;background:linear-gradient(135deg,light-dark(#1e1b2e,#f1f5f9),light-dark(#7c3aed,#8b5cf6) 50%,light-dark(#db2777,#f472b6));-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text;filter:drop-shadow(0 0 40px rgba(139,92,246,.3))}.rd_typography h2{font-size:calc(clamp(32px,6vw,36px));line-height:1.6;letter-spacing:-.02em;background:linear-gradient(135deg,light-dark(#7c3aed,#8b5cf6),light-dark(#db2777,#f472b6));-webkit-background-clip:text;background-clip:text}.rd_typography h2,.rd_typography h3{margin:24px 0 12px;-webkit-text-fill-color:transparent}.rd_typography h3{font-size:calc(clamp(18px,3.5vw,24px));background:light-dark(#7c3aed,#8b5cf6);-webkit-background-clip:text;background-clip:text}.rd_typography h4,.rd_typography h5,.rd_typography h6{font-size:17px;margin-bottom:4px}.rd_typography p{color:var(--rd__root_color-muted);line-height:1.6;margin:24px 0}.rd_typography h4+p,.rd_typography li>p{margin:0}'
